{
  "name": "图片速存助手",
  "manifest_version": 3,
  "version": "2.0.0",
  "description": "鼠标停在图片上按 Alt+1 保存原图，配合桌面程序使用",
  "permissions": [ "downloads", "scripting", "activeTab", "storage", "alarms" ],
  "host_permissions": [ "<all_urls>" ],
  "background": { "service_worker": "background.js" },
  "commands": {
    "save-hover-image": {
      "suggested_key": { "default": "Alt+1" },
      "description": "保存光标下的图片"
    }
  }
}

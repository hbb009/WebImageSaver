{
  "manifest_version": 3,
  "name": "Image Saver Configurable",
  "version": "1.1",
  "permissions": [ "storage", "scripting", "activeTab" ],
  "host_permissions": [ "<all_urls>" ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [ "<all_urls>" ],
      "js": [ "content.js" ]
    }
  ],
  "action": {
    "default_popup": "options.html",
    "default_title": "Image Saver Config"
  },
  "options_page": "options.html"
}
